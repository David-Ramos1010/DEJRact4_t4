meta {
  name: 02 Login
  type: http
  seq: 2
}

post {
  url: http://localhost:8087/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "david@example.com",
    "password": "Password123"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setEnvVar("token", res.body.token);
}
